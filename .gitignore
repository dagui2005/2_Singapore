# =============================================================================
# MATSim 仿真输出（matsim_*_7_6*/ 等实验根目录）
#   - outputs/    : 仿真输出 plans/events/linkstats XML，体量巨大（>5GB）
#   - populations/: 人口 XML（数十 MB）
#   - audit/      : 中间审计（数十 MB）
#   仅保留 configs/ + README.md + STEP*_PREREGISTRATION.md + *.csv/*.json
# =============================================================================
/matsim_*_*/outputs/
/matsim_*_*/populations/
/matsim_*_*/audit/

# 但保留 README 与预注册文档 + 元数据
!/matsim_*_*/README.md
!/matsim_*_*/STEP*_PREREGISTRATION.md

# =============================================================================
# AI 助手 memory / workbuddy 状态（不入库）
# =============================================================================
/Static_ 2026_03/.workbuddy/

# =============================================================================
# 临时探索 / 运行日志（不入库）
# =============================================================================
_explore*.txt
_run*.txt

# =============================================================================
# 工具 / 编辑器原始备份
# =============================================================================
*.user_orig_backup
*.user.bak

# =============================================================================
# 临时 / 调试脚本与目录（"_" 前缀，按工程惯例不入库）
#   - scripts/_*.py : 探测 / 重连 / 日志追加 / 记忆操作 / readme 维护 / 修补
#   - reports/_*/   : 一次性 / 对照 / 负例探测报告目录
#   - 根目录 _*.py  : 顶层临时脚本
#   - scripts/od/_*.npz : numpy 中间缓存
#   - scripts/od/_*/ : 脚本下的临时子目录（_r1r1_neg/ 等）
#   - reports/*/_*/ : 报告下的临时子目录（_dryrun_v10/、_xcheck_*.tsv）
# =============================================================================
/scripts/_*.py
/scripts/**/_*.py
/scripts/od/_*.py
/reports/_*/
/_*.py
/scripts/od/_*.npz
/scripts/od/_*/
/reports/*/_*/
/reports/*/_*.tsv

# =============================================================================
# experiments/ 仿真实验专属过滤
#   实验根目录 E-SB-XX_*/、E-CAP-01_*/ 内：
#   - _cache/          路径/agent 缓存（pkl/npz 已被全局规则过滤，此处再锁目录）
#   - populations/     matsim 人口 XML（数十 MB）
#   - matsim_*/        matlab 命名空间下的中间产物目录（agent assignment CSV）
#   - audit/_exec_cache/   SB-05 特有的 exec 事件缓存
#   - audit/_cycle_linkstats/   收敛用 linkstats 压缩缓存
#   仅保留 README.md / PROTOCOL*.md / VERDICT*.md / configs/*.xml / audit/*.csv/*.json/*.md
# =============================================================================
/experiments/**/_cache/
/experiments/**/populations/
/experiments/**/matsim_*/
/experiments/**/audit/_exec_cache/
/experiments/**/audit/_cycle_linkstats/
/experiments/**/audit/_revision_history/

# 但保留 audit 下的报告文件 + 实验根目录的说明文档
!/experiments/**/*.md
!/experiments/**/configs/*.xml
!/experiments/**/audit/*.csv
!/experiments/**/audit/*.json
!/experiments/**/audit/*.md
