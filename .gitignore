/reports/**/*.txt
/reports/**/*.xml
/reports/**/*.gz
/reports/**/*.parquet
/reports/**/*.png

# =============================================================================
# Singapore_OD_MATSim_FinalData/：完整数据集仓库（9 GB）
#   不入库，使用前按 docs/DATASETS.md 下载后放置此目录
#   10_Documentation/ 下的说明文件保留
# =============================================================================
/Singapore_OD_MATSim_FinalData/**/*.geojson
/Singapore_OD_MATSim_FinalData/**/*.csv
/Singapore_OD_MATSim_FinalData/**/*.xlsx
/Singapore_OD_MATSim_FinalData/**/*.parquet
/Singapore_OD_MATSim_FinalData/**/*.png
/Singapore_OD_MATSim_FinalData/**/*.pdf
/Singapore_OD_MATSim_FinalData/**/*.kml
/Singapore_OD_MATSim_FinalData/**/*.kmz
/Singapore_OD_MATSim_FinalData/**/*.gdb/
/Singapore_OD_MATSim_FinalData/**/07_RoadNetwork/**
/Singapore_OD_MATSim_FinalData/**/05_POI_Enterprise/ACRA/**

# 但保留 10_Documentation 下的说明文件
!/Singapore_OD_MATSim_FinalData/**/*.md
!/Singapore_OD_MATSim_FinalData/**/.gitkeep
!/Singapore_OD_MATSim_FinalData/README.md

# =============================================================================
# Static_ 2026_03/OTHER/goverment_open：政府开放数据集
#   包含 GHS 2025、ACRA、MasterPlan2019 等大型数据，不入库
# =============================================================================
/Static_ 2026_03/OTHER/goverment_open/**

# 但保留 .md / .gitkeep
!/Static_ 2026_03/OTHER/goverment_open/.gitkeep
!/Static_ 2026_03/OTHER/goverment_open/README.md

# siteselect_sg-main/dataset（也是数据集，不入源码仓库）
/Static_ 2026_03/OTHER/siteselect_sg-main/dataset/**

